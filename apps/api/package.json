{
  "name": "@movie-recommender/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "catalog:import": "node --env-file-if-exists=../../.env --import tsx src/modules/movies/seed.ts",
    "catalog:verify": "node --env-file-if-exists=../../.env --import tsx src/modules/movies/seed.ts --verify",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@movie-recommender/shared": "0.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
